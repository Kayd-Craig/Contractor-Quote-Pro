{
  "expo": {
    "name": "QuickQuote Contractor",
    "slug": "quick-quote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quickquote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F4"
    },
    "ios": {
      "bundleIdentifier": "com.joshworks.quickquote",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "QuickQuote Contractor uses your camera to take job-site photos that can be attached to quotes.",
        "NSPhotoLibraryUsageDescription": "QuickQuote Contractor accesses your photo library to attach job-site photos to quotes."
      }
    },
    "android": {
      "package": "com.joshworks.quickquote",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2637bcdd-2c08-4c5a-895e-b3e096345394"
      }
    },
    "owner": "jfins1"
  }
}
